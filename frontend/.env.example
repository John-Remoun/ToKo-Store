# Base URL of the ToKo Store NestJS API (include the /api/v1 prefix)
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# Google Identity Services client ID. Must be one of the IDs configured in
# the backend's CLIENT_IDS env var, or Google sign-in will fail server-side.
VITE_GOOGLE_CLIENT_ID=

# Stripe publishable key (pk_test_... / pk_live_...). Only needed if the
# backend's PAYMENT_PROVIDER is "stripe" (the default).
VITE_STRIPE_PUBLISHABLE_KEY=
