# ==========================================================
# Environment variable template. Copy to .env.development
# (or .env.production) and fill in real values.
# Run `node scripts/generate-env.js` to auto-generate a
# .env.development with fresh random secrets.
# ==========================================================

APPLICATION_NAME=Ecommerce
PORT=3000

# MongoDB connection string (required)
DB_URI=mongodb://localhost:27017/ecommerce

# ---- JWT secrets (use long random hex strings in real environments) ----
User_TOKEN_SECRET_KEY=
User_REFRESH_TOKEN_SECRET_KEY=
System_TOKEN_SECRET_KEY=
System_REFRESH_TOKEN_SECRET_KEY=

ACCESS_EXPIRES_IN=1800
REFRESH_EXPIRES_IN=31536000

# ---- Password hashing ----
SALT_ROUND=10

# ---- Field-level encryption (used for phone numbers) ----
# ENC_KEY must be a 64-character hex string (32 bytes)
ENC_KEY=
ENC_BYTE=
ENC_IV_LENGTH=16

# ---- CORS ----
ORIGINS=http://localhost:3000

CLIENT_IDS=

# ---- Email (Gmail SMTP app password) ----
EMAIL_APP=
EMAIL_APP_PASSWORD=

# ---- Social links (optional) ----
FACEBOOK_LINK=
INSTAGRAM_LINK=
TWITTER_LINK=

# ---- Redis (optional; caching / BullMQ queues) ----
REDIS_URI=redis://localhost:6379

# ---- AWS S3 (file uploads) ----
S3_REGION=us-east-1
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_ACCESS_SECRET_KEY=
S3_EXPIRES_IN=120

# ---- Stripe (payments) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Payment provider selection ----
# One of: stripe | paymob | paypal (defaults to stripe if unset).
# Paymob and PayPal are scaffolded (see src/modules/payment/providers/) —
# fill in their env vars below once you finish wiring the provider.
PAYMENT_PROVIDER=stripe

# ---- Paymob (optional, if PAYMENT_PROVIDER=paymob) ----
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ---- PayPal (optional, if PAYMENT_PROVIDER=paypal) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ---- Google OAuth (Sign in with Google) ----
# Frontend uses this Client ID with Google Identity Services to obtain an
# ID token, then POSTs it to /api/v1/auth/google. See SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cloudinary (image uploads, alternative to S3) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ecommerce

# ---- Meta Pixel / Conversions API ----
# Public pixel ID, safe to expose via GET /api/v1/config/meta-pixel.
META_PIXEL_ID=
# Server-side Conversions API token — keep secret, server-only.
META_CONVERSIONS_API_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Optional: set while testing in Meta Events Manager's "Test Events" tab.
META_TEST_EVENT_CODE=

# ---- Email SMTP (used by @nestjs-modules/mailer; Gmail app password by default) ----
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false

# ---- Email verification enforcement ----
REQUIRE_EMAIL_VERIFICATION=false
